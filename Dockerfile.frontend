# ── Stage 1: build ───────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

RUN npm install -g bun

COPY package.json bun.lockb* ./
RUN bun install --frozen-lockfile || bun install

COPY . .

# VITE_API_BASE встраивается в JS-бандл на этапе сборки.
# Браузер пользователя обращается на этот адрес напрямую.
# По умолчанию: http://localhost:8000 (порт бэкенда, проброшен на хост).
ARG VITE_API_BASE=http://localhost:8000
ENV VITE_API_BASE=$VITE_API_BASE

RUN bun run build

# ── Stage 2: serve ────────────────────────────────────────────
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html

# Только SPA-роутинг — без прокси на бэкенд
RUN printf 'server {\n\
    listen 80;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
