# ── Stage 1: build ───────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

RUN npm install -g bun

COPY package.json bun.lockb* ./
RUN bun install --frozen-lockfile || bun install

COPY . .

# VITE_API_BASE пустая строка → фронтенд использует относительные пути /api/...
# которые nginx проксирует на backend:8000
ARG VITE_API_BASE=""
ENV VITE_API_BASE=$VITE_API_BASE

RUN bun run build

# ── Stage 2: serve ────────────────────────────────────────────
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html

# SPA-роутинг + прокси /api/* → backend:8000
RUN printf 'server {\n\
    listen 80;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
\n\
    # Проксируем API-запросы на бэкенд\n\
    location /api/ {\n\
        proxy_pass http://backend:8000/api/;\n\
        proxy_set_header Host $host;\n\
        proxy_set_header X-Real-IP $remote_addr;\n\
        proxy_read_timeout 30s;\n\
    }\n\
\n\
    # SPA: все остальные пути отдаём index.html\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
