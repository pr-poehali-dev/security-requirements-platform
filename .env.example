# Локальный запуск через Docker
# Скопируй в .env и при необходимости измени значения

# URL бэкенда (для фронтенда в Docker)
VITE_API_BASE=http://localhost:8000

# Строка подключения к БД (используется бэкендом внутри контейнера)
DATABASE_URL=postgresql://postgres:postgres@db:5432/securearch?options=-csearch_path%3Dt_p90536134_security_requirement
